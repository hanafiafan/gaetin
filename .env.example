# ============================================================================
# KONFIGURASI ENVIRONMENT — Gaetin
#
# Legenda:
#   [WAJIB · GRATIS]      = harus diisi untuk menjalankan sistem; tanpa biaya
#   [WAJIB JIKA JUAL]     = wajib hanya kalau menerima pembayaran langganan
#   [OPSIONAL · GRATIS]   = boleh kosong; ada free tier
#   [OPSIONAL · BERBAYAR] = hanya jika butuh; menambah biaya — tunda di awal
#
# Prinsip: untuk MVP cukup isi blok [WAJIB · GRATIS] saja. Semuanya bisa
# berjalan dengan satu VPS tanpa langganan pihak ketiga.
# ============================================================================

# ---------- [WAJIB · GRATIS] DATABASE (self-host) ----------
DATABASE_URL="postgresql://postgres:password@localhost:5432/hellens_scraper?schema=public"

# ---------- [WAJIB · GRATIS] AUTH (kamu generate sendiri) ----------
# Buat dengan: openssl rand -base64 48
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"
JWT_EXPIRES_IN="24h"

# ---------- [WAJIB · GRATIS] APP ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------- [OPSIONAL · GRATIS] DOMAIN ADMIN / CMS OWNER ----------
# Kosongkan saat development agar /admin tetap bisa dibuka lewat localhost.
# Saat produksi, isi agar admin/CMS hanya diarahkan lewat domain khusus.
# Contoh:
#   DOMAIN="scraper.hellens.dev"
#   ADMIN_DOMAIN="admin.scraper.hellens.dev"
#   ADMIN_HOSTS="admin.scraper.hellens.dev"
#   ADMIN_PRIMARY_URL="https://admin.scraper.hellens.dev"
#   ADMIN_ENTRY_PATH="/owner-console"
#   AUTH_COOKIE_DOMAIN=".hellens.dev"
DOMAIN="localhost"
ADMIN_DOMAIN="admin.localhost"
ADMIN_HOSTS=""
ADMIN_PRIMARY_URL=""
ADMIN_ENTRY_PATH=""
AUTH_COOKIE_DOMAIN=""

# ---------- [WAJIB · SELF-HOSTED] WHATSAPP GATEWAY ----------
# baileys = gratis, koneksi via QR (default & direkomendasikan)
# gateway / cloud_api = opsional & berbayar (lihat blok di bawah)
WA_PROVIDER="gateway"
WA_SESSION_DIR="./wa-sessions"
# Kode negara default (tanpa +) dipakai hanya untuk nomor lokal yang diawali "0"
# tanpa kode negara eksplisit. Nomor yang sudah punya kode negara (mis. +1..., +62...)
# tidak diubah — jadi ini tidak membatasi ke satu negara, hanya fallback nomor lokal.
DEFAULT_COUNTRY_CODE="62"

# ---------- [WAJIB JIKA JUAL] BILLING — Midtrans (per-transaksi) ----------
# Dari dashboard Midtrans (Settings > Access Keys). Boleh isi key sandbox (prefix SB-Mid-...)
# untuk development, atau key production (prefix Mid-...) — jangan commit nilai asli ke git,
# isi langsung di .env lokal / secret manager (mis. Coolify env vars).
MIDTRANS_MERCHANT_ID=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# ---------- [OPSIONAL · GRATIS] EMAIL (free tier Resend/Brevo/SMTP) ----------
# Untuk invoice, reset password, notifikasi. Boleh kosong saat dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@hellens.dev"

# ============================================================================
# OPSIONAL · BERBAYAR — JANGAN diisi di awal. Tambahkan hanya bila terbukti
# perlu, dan biayanya ditutup oleh paket langganan / pakai key milik tenant.
# ============================================================================

# ---------- [WAJIB UNTUK WHATSAPP] GATEWAY INTERNAL ----------
WA_GATEWAY_BASE_URL="http://localhost:3001"
WA_GATEWAY_TOKEN=""
WEBHOOK_SECRET=""
# Isi kedua secret dengan nilai acak berbeda. Cloud API di bawah belum didukung.
WA_CLOUD_API_TOKEN=""
WA_CLOUD_PHONE_NUMBER_ID=""

# ---------- [OPSIONAL · BERBAYAR] STORAGE S3 (kalau tak pakai disk VPS) ----------
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""

# Worker wajib berjalan: npm run worker (Node.js 22.12+).
# Gunakan WA_GATEWAY_TOKEN dan WEBHOOK_SECRET yang berbeda dari JWT_SECRET.
# TEST_DATABASE_URL hanya untuk database pengujian terpisah.

# ---------- [OPSIONAL] LAMPIRAN PESAN ----------
# Folder tempat foto/dokumen yang dikirim lewat Pesan Masuk disimpan.
# Di Compose ini diisi /app/media (volume bersama app + gateway).
# Kosongkan untuk memakai folder .media di dalam project (untuk development).
MEDIA_DIR=""
